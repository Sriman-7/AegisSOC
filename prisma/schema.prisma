generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SecurityIncident {
  id                    String            @id @default(cuid())
  title                 String
  description           String
  severity              String            // CRITICAL, HIGH, MEDIUM, LOW
  status                String            // OPEN, INVESTIGATING, MITIGATED, RESOLVED
  attackType            String            // Ransomware, Credential Stuffing, APT Lateral Movement, DNS Exfiltration, etc.
  attackPhase           String            // Initial Access, Execution, Lateral Movement, Exfiltration
  confidence            Float             // 0.0 to 1.0
  riskScore             Float             // 0 to 100
  blastRadius           Float             // percentage 0 to 100
  affectedAssets        String            // JSON string array of asset IDs or hostnames
  attackSequence        String            // JSON string of attack steps
  mitreTechniques       String            // JSON string array of MITRE codes (e.g. ["T1078", "T1059"])
  iocs                  String            // JSON string of indicators of compromise
  aiReasoning           String            // Natural language AI reasoning & evidence
  recommendedActions    String            // JSON string array of suggested actions
  isAutonomousMitigated Boolean           @default(false)
  feedbackStatus        String?           // CONFIRMED_TRUE_POSITIVE, FALSE_POSITIVE, PENDING
  scenarioKey           String?           // A, B, C, D, E, F
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  events                TelemetryEvent[]
  actions               DefenseAction[]
  feedbacks             AnalystFeedback[]
}

model TelemetryEvent {
  id                String            @id @default(cuid())
  timestamp         DateTime          @default(now())
  sourceType        String            // NETWORK, SYSTEM, AUTH, ALERT
  sourceIp          String?
  destIp            String?
  port              Int?
  protocol          String?
  username          String?
  hostname          String?
  processName       String?
  action            String
  status            String            // ALLOW, BLOCK, DROP, SUSPICIOUS, ANOMALOUS
  anomalyScore      Float             @default(0)
  confidence        Float             @default(0)
  isAnomaly         Boolean           @default(false)
  isBenign          Boolean           @default(false)
  zNorm             Float             @default(0)
  entropyDrift      Float             @default(0)
  sequenceRisk      Float             @default(0)
  intelMatch        Float             @default(0)
  contextMultiplier Float             @default(1.0)
  reasons           String?           // JSON string of structured reasons { feature, observed, baseline, contribution }
  details           String?           // JSON string with extra details
  incidentId        String?
  incident          SecurityIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model Asset {
  id          String    @id @default(cuid())
  hostname    String    @unique
  ipAddress   String
  assetType   String    // SERVER, ENDPOINT, DATABASE, GATEWAY, CLOUD_VPC
  role        String    // Domain Controller, Payment DB, etc.
  criticality String    // CRITICAL, HIGH, MEDIUM, LOW (0.8 to 1.4 weight)
  status      String    // HEALTHY, SUSPICIOUS, COMPROMISED, ISOLATED
  riskScore   Float     @default(0)
  lastActive  DateTime  @default(now())
  isolatedAt  DateTime?
}

model DefenseAction {
  id              String            @id @default(cuid())
  actionType      String            // ISOLATE_HOST, BLOCK_IP, REVOKE_TOKEN, KILL_PROCESS, FIREWALL_DROP, RATE_LIMIT, MFA_CHALLENGE
  target          String            // IP, Hostname, or User
  incidentId      String?
  incident        SecurityIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  status          String            // EXECUTED, REVERTED, PENDING_APPROVAL, FAILED
  isAutonomous    Boolean           @default(true)
  latencyMs       Int               @default(120)
  reason          String
  rollbackPayload String?           // JSON string of commands/state needed to reverse action
  executedAt      DateTime          @default(now())
  revertedAt      DateTime?
  revertedBy      String?
}

model AnalystFeedback {
  id               String           @id @default(cuid())
  incidentId       String
  incident         SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  verdict          String           // TRUE_POSITIVE, FALSE_POSITIVE, BENIGN_EXCEPTION
  analystNotes     String?
  beforeConfidence Float            @default(0)
  afterConfidence  Float            @default(0)
  tuningAdjustment String?
  createdAt        DateTime         @default(now())
}

model DetectionRule {
  id                   String   @id @default(cuid())
  name                 String
  category             String   // NETWORK, AUTH, PROCESS, BEHAVIORAL
  wZNorm               Float    @default(0.35)
  wEntropy             Float    @default(0.20)
  wSequence            Float    @default(0.25)
  wIntel               Float    @default(0.20)
  suppressionFactor    Float    @default(1.0)
  whitelistEntities    String   @default("[]") // JSON string array of whitelisted IPs/processes
  thresholdMedium      Float    @default(0.35)
  thresholdHigh        Float    @default(0.55)
  thresholdCritical    Float    @default(0.80)
  updatedAt            DateTime @updatedAt
}

model SecuritySetting {
  id                     String   @id @default("global")
  autonomousMode         Boolean  @default(true)
  minConfidenceForAction Float    @default(0.75)
  simulationRunning      Boolean  @default(false)
  geminiApiKey           String?
  updatedAt              DateTime @updatedAt
}

model EvaluationRun {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  detectionLatencyMs Float
  responseLatencyMs  Float
  precisionBefore    Float
  recallBefore       Float
  f1Before           Float
  fprBefore          Float
  precisionAfter     Float
  recallAfter        Float
  f1After            Float
  fprAfter           Float
  details            String   // JSON string of scenario outcomes
}